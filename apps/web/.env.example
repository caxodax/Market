# ==============================================================================
# MarketOS Production Environment Variables (apps/web)
# ==============================================================================

# 1. SUPABASE (Database, Auth, Postgres Storage)
# Obtener en: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 2. UPSTASH REDIS (Cache de tasas, rate limiting y sesiones)
# Obtener en: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# 3. CLOUDFLARE R2 (Almacenamiento de fotos de productos y comprobantes)
# Obtener en: Cloudflare Dashboard > R2 Object Storage > Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=marketos-media
R2_PUBLIC_DOMAIN=https://pub-your-id.r2.dev

# 4. CRON JOB SECURITY (Vercel Cron / External Trigger)
# Token secreto para proteger el endpoint /api/cron/bcv-sync
CRON_SECRET=your-random-cron-secret-token

# 5. CONFIGURACIÓN DEL TENANT POR DEFECTO
DEFAULT_TENANT_ID=shop-market-ca
DEFAULT_TENANT_NAME="Shop Market C.A."
DEFAULT_CURRENCY=USD
