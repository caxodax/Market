# MarketOS Environment Configuration Template

# -------------------------------------------------------------
# SUPABASE CONFIGURATION (Database & Auth)
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -------------------------------------------------------------
# UPSTASH REDIS CONFIGURATION (Cache, Rate Limiting & Cart)
# -------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# -------------------------------------------------------------
# CLOUDFLARE R2 CONFIGURATION (Storage)
# -------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=marketos-assets
R2_PUBLIC_DOMAIN=https://assets.marketos.app

# -------------------------------------------------------------
# EXTERNAL APIS & CURRENCY
# -------------------------------------------------------------
BCV_API_URL=https://bcv.today/api/

# -------------------------------------------------------------
# TENANT DEFAULTS (First Tenant: Shop Market C.A.)
# -------------------------------------------------------------
DEFAULT_TENANT_ID=shop-market-ca
DEFAULT_TENANT_NAME="Shop Market C.A."
DEFAULT_CURRENCY=USD
